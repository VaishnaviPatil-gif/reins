# PayPal Sandbox credentials — get from developer.paypal.com
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Gemini API credentials — get from aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Public base URL for OAuth and PayPal redirect callbacks
PUBLIC_BASE_URL=http://localhost:8000

# Frontend URL for browser redirects and CORS
FRONTEND_BASE_URL=http://localhost:5173

# Safety Net: When true, approved purchases without a vault token return an approve_url
PAYPAL_VAULT_FALLBACK=false

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
REINS_SIGNING_SECRET=change_this_to_a_random_64_char_hex_string

# SQLite DB path (relative to backend/)
DATABASE_URL=sqlite:///./reins.db
