# PayPal Sandbox credentials — get from developer.paypal.com
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Gemini API key — get from aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
REINS_SIGNING_SECRET=change_this_to_a_random_64_char_hex_string

# SQLite DB path (relative to backend/)
DATABASE_URL=sqlite:///./reins.db
